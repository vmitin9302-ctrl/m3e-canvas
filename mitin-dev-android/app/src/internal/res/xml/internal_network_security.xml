<network-security-config>
    <base-config cleartextTrafficPermitted="false"><trust-anchors><certificates src="system"/></trust-anchors></base-config>
    <!-- This source set has no release variant. User-installed LOCAL test CAs
         allow USB testing with a newly generated local CA after CI is destroyed. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">localhost</domain><domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors><certificates src="@raw/mitin_test_ca"/><certificates src="user"/></trust-anchors>
    </domain-config>
</network-security-config>
